                    </VBox>

                    <VBox id="_IDGenVBox14" >
                        <Text id="_IDGenText11" text="Last Name" />
                        <Input id="_IDGenInput5" type="Text" />
                    </VBox>
                </HBox>

                <VBox id="_IDGenVBox15" class="sapUiSmallMarginBottom">
                    <Text id="_IDGenText12" text="Address" />
                    <Input id="_IDGenInput6" type="Text" />
                </VBox>

               

                <HBox id="_IDGenHBox9" class="sapUiSmallMarginBottom">
                    <VBox id="_IDGenVBox16" class="sapUiSmallMarginEnd">
                        <Text id="_IDGenText13" text="City" />
                        <Input id="_IDGenInput7" type="Text" />
                    </VBox>

                    <VBox id="_IDGenVBox17" >
                        <Text id="_IDGenText14" text="Phone Number" />
                        <Input id="_IDGenInput8" type="Tel" />
                    </VBox>
                </HBox>

                <HBox id="_IDGenHBox10" class="sapUiSmallMarginBottom">
                    <VBox id="_IDGenVBox18" class="sapUiSmallMarginEnd">
                        <Text id="_IDGenText15" text="State" />
                        <Input id="_IDGenInput9" type="Text" />
                    </VBox>

                    <VBox id="_IDGenVBox19" >
                        <Text id="_IDGenText16" text="Postal Code" />
                        <Input id="_IDGenInput10" type="Text" />
                    </VBox>
                </HBox>

                <HBox id="_IDGenHBox11" class="sapUiSmallMarginBottom">
                    <VBox id="_IDGenVBox20" class="sapUiSmallMarginEnd">
                        <Text id="_IDGenText17" text="Date of Birth" />
                        <Input id="_IDGenInput11" type="Text" />
                    </VBox>

                    <VBox id="_IDGenVBox21" >
                        <Text id="_IDGenText18" text="SSN" />
                        <Input id="_IDGenInput12" type="Number" />
                    </VBox>
                </HBox>


                <VBox id="_IDGenVBox9" class="sapUiSmallMarginBottom">
                    <Text id="_IDGenText6" text="Email" />
                    <Input id="_IDGenInput2" type="Email" />
                </VBox>

                <VBox id="_IDGenVBox10" class="sapUiSmallMarginBottom">
