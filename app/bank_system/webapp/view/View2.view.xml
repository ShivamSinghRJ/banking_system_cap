                </HBox>
                </VBox>
                <VBox id="_IDGenVBox11" />
            </HBox>

            <HBox id="_IDGenHBox7" class="hbox1" width="50%" justifyContent="Center" alignItems="Center">
                <VBox id="_IDGenVBox12" class="sapUiSmallMargin">
                <Text id="_IDGenText9" text=" We are so excited to have you here.If you haven't already, create an account to get access to exclusive offers, rewards, and discounts." />
