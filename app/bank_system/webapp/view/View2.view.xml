<mvc:View controllerName="banksystem.controller.View2"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page2" title="{i18n>title}">
        <ScrollContainer id="_IDGenScrollContainer" vertical="true" horizontal="false" height="100%">

        <VBox id="_IDGenVBox7" class="vbox1 sapUiSmallMargin" height="100%"  >
            <HBox id="_IDGenHBox1" width="50%" justifyContent="Center">
                <VBox id="_IDGenVBox8" justifyContent="Center">
                <HBox id="_IDGenHBox5" class="sapUiSmallMarginBottom">
