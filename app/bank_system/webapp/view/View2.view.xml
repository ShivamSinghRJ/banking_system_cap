<mvc:View controllerName="banksystem.controller.View2"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core" 
    >
    <Page id="page2" title="{i18n>title}">
        <ScrollContainer id="_IDGenScrollContainer" vertical="true" horizontal="false" height="100%">

        <VBox id="_IDGenVBox7" class="vbox1 sapUiSmallMargin" height="100%"  >
            <HBox id="_IDGenHBox1" width="50%" justifyContent="Center">
                <VBox id="_IDGenVBox8" justifyContent="Center">
                <HBox id="_IDGenHBox5" class="sapUiSmallMarginBottom">
                    <Image id="_IDGenImage1" class="sapUiTinyMarginEnd" src="image/cube.png" width="40px" height="40px" />
                    <Title id="_IDGenTitle1" class="txt0" text="Horizon" level="H1" />
                </HBox>
                <Title id="_IDGenTitle3" class="title0" text="Sign up" level="H1" />
                <Text id="_IDGenText5" class="sapUiSmallMarginBottom" text="Please enter your details" />

                <HBox id="_IDGenHBox8" class="sapUiSmallMarginBottom">
                    <VBox id="_IDGenVBox13" class="sapUiSmallMarginEnd">
                        <Label id="_IDGenText10" text="First Name" required="true" ></Label>
                        <Input id="_IDGenInput4" type="Text" required="true"  />
                        <MessageStrip id="_IDGenMessageStrip2"  text="name is required" type="Error" visible="false" />
                        
                    </VBox>

                    <VBox id="_IDGenVBox14" >
                        <Label id="_IDGenText11" text="Last Name"  required="true" />
                        <Input id="_IDGenInput5" type="Text" required="true" />
                        <MessageStrip id="_IDGenMessageStrip3"  text="name is required" type="Error" visible="false" />
                    </VBox>
                </HBox>

                <VBox id="_IDGenVBox15" class="sapUiSmallMarginBottom">
                    <Label id="_IDGenText12" text="Address" />
                    <Input id="_IDGenInput6" type="Text" />
                </VBox>

               

                <HBox id="_IDGenHBox9" class="sapUiSmallMarginBottom">
                    <VBox id="_IDGenVBox16" class="sapUiSmallMarginEnd">
                        <Label id="_IDGenText13" text="City" />
                        <Input id="_IDGenInput7" type="Text" />
                    </VBox>

                    <VBox id="_IDGenVBox17" >
                        <Label id="_IDGenText14" text="Phone Number"  required="true" />
                        <Input id="_IDGenInput8" type="Tel" required="true" />
                        <MessageStrip id="_IDGenMessageStrip5"  text="name is required" type="Error" visible="false" />
                    </VBox>
                </HBox>

                <HBox id="_IDGenHBox10" class="sapUiSmallMarginBottom">
                    <VBox id="_IDGenVBox18" class="sapUiSmallMarginEnd">
                        <Label id="_IDGenText15" text="State"   />
                        <Input id="_IDGenInput9" type="Text" />
                    </VBox>

                    <VBox id="_IDGenVBox19" >
                        <Label id="_IDGenText16" text="Postal Code"  required="true" />
                        <Input id="_IDGenInput10" type="Text" />
                         <MessageStrip id="_IDGenMessageStrip1"   text="name is required" type="Error" visible="false" />
                  
                    </VBox>
                </HBox>

                <HBox id="_IDGenHBox11" class="sapUiSmallMarginBottom">
                    <VBox id="_IDGenVBox20" class="sapUiSmallMarginEnd">
                        <Label id="_IDGenText17" text="Date of Birth"  required="true" />
                        <DatePicker id="_IDGenDatePicker" required="true" ></DatePicker>
                        <MessageStrip id="_IDGenMessageStrip6"  text="name is required" type="Error" visible="false" />
                    </VBox>

                    <VBox id="_IDGenVBox21" >
                        <Text id="_IDGenText18" text="SSN" />
                        <Input id="_IDGenInput12" type="Number" />
                    </VBox>
                </HBox>

                 <VBox id="_IDGenVBox56"  class="sapUiSmallMarginBottom">
                    <Label id="_IDGenLabel22"  text="Gender"  required="true" />
                    <ComboBox id="_IDGenSelectList1" required="true" selectedKey="gender" >
					    <core:ListItem id="_IDGenListItem" key="Male" text="Male" icon="sap-icon://male"/>
                        <core:ListItem id="_IDGenListItem1" key="Female" text="Female" icon="sap-icon://female"/>
                        <core:ListItem id="_IDGenListItem2" key="Other" text="Other" icon="sap-icon://gender-male-and-female"/>
				    </ComboBox>
                    <MessageStrip id="_IDGenMessageStrip4"  text="name is required" type="Error" visible="false" />
                </VBox>


                <VBox id="_IDGenVBox9" class="sapUiSmallMarginBottom">
                    <Label id="_IDGenText6" text="Email"  required="true" />
                    <Input id="_IDGenInput2" type="Email" required="true" />
                    <MessageStrip id="_IDGenMessageStrip7"  text="name is required" type="Error" visible="false" />
                </VBox>

                <VBox id="_IDGenVBox10" class="sapUiSmallMarginBottom">
                    <Label id="_IDGenText7" text="Password"  required="true" />
                    <Input id="_IDGenInput3" type="Password" required="true"/>
                    <MessageStrip id="_IDGenMessageStrip8"  text="name is required" type="Error" visible="false" />
                </VBox>

                <Button id="_IDGenButton3" text="Sign Up" press="signUp" type="Emphasized" width="100%" />
                <MessageStrip id="_IDGenMessageStrip9" text="Account Is Alredy Present" type="Error" visible="false" class="sapUiSmallMarginBottom" />

                <HBox id="_IDGenHBox6" alignItems="Center">
                    <Text id="_IDGenText8" class="sapUiSmallMarginEnd" text="Already have an account?" />
                    <Button id="_IDGenButton4" text="Login" type="Transparent" press="login" />
                </HBox>
                </VBox>
                <VBox id="_IDGenVBox11" />
            </HBox>

            <HBox id="_IDGenHBox7" class="hbox1" width="50%" justifyContent="Center" alignItems="Center">
                <VBox id="_IDGenVBox12" class="sapUiSmallMargin">
                <Text id="_IDGenText9" text=" We are so excited to have you here.If you haven't already, create an account to get access to exclusive offers, rewards, and discounts." />
                <Button id="_IDGenButton5" text="Already have an account? Login." type="Transparent" press="login" />
                </VBox>
            </HBox>
            </VBox>
    </ScrollContainer>
    </Page>
</mvc:View>