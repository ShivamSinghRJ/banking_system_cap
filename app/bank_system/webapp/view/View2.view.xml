                    <Title id="_IDGenTitle1" class="txt0" text="Horizon" level="H1" />
                </HBox>
                <Title id="_IDGenTitle3" class="title0" text="Sign up" level="H1" />
                <Text id="_IDGenText5" class="sapUiSmallMarginBottom" text="Please enter your details" />

                <HBox id="_IDGenHBox8" class="sapUiSmallMarginBottom">
                    <VBox id="_IDGenVBox13" class="sapUiSmallMarginEnd">
                        <Text id="_IDGenText10" text="First Name" />
