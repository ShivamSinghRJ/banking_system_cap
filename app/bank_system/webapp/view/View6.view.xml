<mvc:View controllerName="banksystem.controller.View6"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
     xmlns:core="sap.ui.core">
    <Page id="page6" title="{i18n>title}">
        <HBox id="_IDGenHBox25">
            <VBox id="_IDGenVBox39" width="21%" height="100%">
                <HBox id="_IDGenHBox27" class="sapUiLargeMarginBottom">
                <Image id="_IDGenImage6" class="sapUiTinyMarginEnd" src="image/cube.png" width="40px" height="40px" />
                <Title id="_IDGenTitle15" class="txt0" text="Horizon" level="H1" />
                </HBox>

                <SearchField id="_IDGenSearchField3" width="80%" class="sapUiSmallMargin" placeholder="Search" />

                <VBox id="_IDGenVBox40" class="sapUiSmallMarginStart">
                <Button id="_IDGenButton22" text="Home" icon="sap-icon://home" type="Transparent" textDirection="LTR" width="45%" class="btn0" press="home" />
                <Button id="_IDGenButton23" text="My Bank" icon="sap-icon://home" type="Transparent" width="51%" press="Onbank" class="btn0"  />
                <Button id="_IDGenButton24" text="Transaction History" icon="sap-icon://home" type="Transparent" width="75%" press="history" class="btn0" />
                <Button id="_IDGenButton25" text="Payment Transfer" icon="sap-icon://home" type="Emphasized" width="71%" class="btn0" press="paymentTranfer" />
                <Button id="_IDGenButton26" text="Connect Bank" icon="sap-icon://home" type="Transparent" width="62%" class="btn0" press="connectBank" />
                <Button id="_IDGenButton42"   text="Add Money" icon="sap-icon://home" type="Transparent" width="56%" press="addMoney" class="btn0"></Button>
                    
                </VBox>
            </VBox>

            <VBox id="_IDGenVBox41" width="79%" class="sapUiTinyMarginEnd">
                <Title id="_IDGenTitle16" text="Payment Transfer" level="H1" class="sapUiLargeMarginTop sapUiLargeMarginStart" />
                <Text id="_IDGenText44" text="Please provide any specific details or notes related to the payment transfer" class="sapUiSmallMarginStart sapUiLargeMarginBottom" />
               
                 
                <HBox id="_IDGenHBox28" alignItems="Center"  class="sapUiSmallMarginTop">
                    <VBox id="_IDGenVBox42" class="sapUiLargeMarginEnd" width="250px" >
                        <Label id="_IDGenLabel4" text="Select Source Bank"  required="true" ></Label>
                        <Text id="_IDGenText48" text="Select the bank account you want to transfer funds from" class="sapUiSmallMarginStart"></Text>
                    </VBox>

                    <ComboBox id="_IDGenComboBox2" placeholder="Select Bank Name" items="{BankModel>/}"  selectedKey="{selectedBank}" required="true">
                            <core:Item id="_IDGenItem6" key="{BankModel>bank_name}" text="{BankModel>bank_name}" />
                    </ComboBox>
                </HBox>

                
                 <HBox id="_IDGenHBox30" class="sapUiLargeMarginBottom sapUiSmallMarginTop" alignItems="Center">
                    <VBox id="_IDGenVBox44" class="sapUiSmallMarginEnd" width="280px">
                        <Label id="_IDGenLabel5" text="Transfer Note (Optional)"></Label>
                        <Text id="_IDGenText49" text="Please provide any additional information or instruction related to the transfer" ></Text>
                    </VBox>
                   <TextArea id="_IDGenTextArea" rows="3" width="243%" valueState="Information" placeholder="Write a short note here"></TextArea>
                </HBox>
                
                <Title id="_IDGenTitle18" text="Bank account details"></Title>
                <Text id="_IDGenText50" text="Enter the bank account details of the recipiant"></Text>

                <HBox id="_IDGenHBox50"  class="sapUiLargeMarginTop" alignItems="Center">
                    <Label id="_IDGenLabel20"  text="Card Number" width="290px" required="true"></Label>
                    <Input id="_IDGenInput24"  type="Number" editable="true" required="true"></Input>
                </HBox>

                 <HBox id="_IDGenHBox51"  class="sapUiSmallMarginTop" alignItems="Center">
                    <Label id="_IDGenLabel21"  text="Expiry Date Of Card Number" width="290px" required="true"></Label>
                    <DatePicker id="_IDGenInput25" required="true" ></DatePicker>
                    <!-- <Input id="_IDGenInput25" placeholder="YYYY-MM-DD"  type="Text" editable="true" required="true"></Input> -->
                </HBox>

               <HBox id="_IDGenHBox31" class="sapUiSmallMarginTop" alignItems="Center">
                    <Label id="_IDGenLabel6" text="Email Address" width="290px" required="true"></Label>
                    <Input id="_IDGenInput13" type="Email" editable="false"></Input>
               </HBox>

               
               <HBox id="_IDGenHBox52" class="sapUiSmallMarginTop" alignItems="Center">
                    <Label id="_IDGenLabel23" text="Recipient's Email Address" width="290px"  required="true"></Label>
                    <Input id="_IDGenInput11" type="Email"  required="true" ></Input>
               </HBox>
                <HBox id="_IDGenHBox32" class="sapUiSmallMarginTop" alignItems="Center">
                    <Label id="_IDGenLabel7" text="Recipient's Bank Account Number" width="290px"  required="true"></Label>
                    <Input id="_IDGenInput14" type="Number" maxLength="16"  required="true" ></Input>
               </HBox>

                <HBox id="_IDGenHBox53" class="sapUiSmallMarginTop" alignItems="Center">
                    <Label id="_IDGenLabel24"  text="Transaction" width="290px"  required="true"></Label>
                    <ComboBox id="_IDGenComboBox4"  placeholder="Transaction Type"  selectedKey="selectedTrans" required="true">
                            <core:Item id="_IDGenItem1"  key="" text="Bill Payement" />
                             <core:Item id="_IDGenItem4"  key="" text="Loan Repayment" />
                            <core:Item id="_IDGenItem5"  key="" text="Tax Payment" />
                            <core:Item id="_IDGenItem7"  key="" text="Donation" />
                            <core:Item id="_IDGenItem8"  key="" text="Money Transfer" />
                    </ComboBox>
               </HBox>
                <HBox id="_IDGenHBox54"  class="sapUiSmallMarginTop" alignItems="Center">
                    <Label id="_IDGenLabel25"  text="Transaction Category" width="290px"  required="true"></Label>
                     <ComboBox id="_IDGenComboBox5"  placeholder="Category"   selectedKey="selectedCategory" required="true">
                            <core:Item id="_IDGenItem12"   key="" text="Utilities" />
                            <core:Item id="_IDGenItem13"   key="" text="Rent And Lease" />
                            <core:Item id="_IDGenItem14"   key="" text="Procurement" />
                            <core:Item id="_IDGenItem15"   key="" text="Travel And Lodging" />
                            <core:Item id="_IDGenItem16"   key="" text="Loan And Interest" />
                            <core:Item id="_IDGenItem17"   key="" text="Insurance" />
                    </ComboBox>
               </HBox>

                <HBox id="_IDGenHBox33" class="sapUiSmallMarginTop sapUiLargeMarginBottom" alignItems="Center">
                    <Label id="_IDGenLabel8" text="Amount" width="290px"  required="true"></Label>
                    <Input id="_IDGenInput15" type="Number" maxLength="16"  required="true" ></Input>
               </HBox>


               <Button id="_IDGenButton27" text="Transfer Funds" type="Emphasized" width="70%" class="sapUiLargeMarginStart" press="onTransfer" ></Button>

            </VBox>
            </HBox>

            <footer>
            <Toolbar id="_IDGenToolbar5" width="260px" design="Transparent">
                <content>
                <HBox id="_IDGenHBox29">
                    <Avatar id="_IDGenAvatar4" displayShape="Circle" initials="SK" displaySize="XS" tooltip="Profile Avatar" class="sapUiTinyMarginEnd avt2" />
                    <VBox id="_IDGenVBox43">
                    <Title id="_IDGenTitle17" text="Shivam Kumar" level="H3" class="tit1" />
                    <Text id="_IDGenText45" text="shivam.t.kumar@capgemini.com" class="txt3" />
                    </VBox>
                </HBox>
                </content>
            </Toolbar>
            </footer>

    </Page>
</mvc:View>