<mvc:View controllerName="banksystem.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">

        <VBox id="_IDGenVBox1" class="vbox1" >
            <HBox id="_IDGenHBox" width="50%" justifyContent="Center" >
                <VBox id="_IDGenVBox2" justifyContent="Center" >
                    <HBox id="_IDGenHBox2" class="sapUiLargeMarginBottom" >
                        <Image id="_IDGenImage" class="sapUiTinyMarginEnd" src="image/cube.png" width="40px" height="40px"></Image>
                        <Title id="_IDGenTitle" class="txt0" text="Horizon" level="H1"></Title>
                    </HBox>
                    <Title id="_IDGenTitle2" class="title0" text="Login in"></Title>
                    <Text id="_IDGenText4" class="sapUiLargeMarginBottom" text="Welcome back! Please enter your details"></Text>
                    

                    <VBox id="_IDGenVBox4" class="sapUiSmallMarginBottom" >
                        <Text id="_IDGenText" text="Email"></Text>
                        <Input id="_IDGenInput" type="Email"></Input>
                    </VBox>
                    <VBox id="_IDGenVBox5" class="sapUiSmallMarginBottom" >
                        <Text id="_IDGenText1" text="Password"></Text>
                        <Input id="_IDGenInput1" type="Password"></Input>
                    </VBox>

                    <Button id="_IDGenButton1" text="Login" type="Emphasized" width="100%" class="sapUiSmallMarginBottom" press="login"></Button>

                    <HBox id="_IDGenHBox4"  alignItems="Center" >
                        <Text id="_IDGenText3" class="sapUiSmallMarginEnd" text="Don't have an account?"></Text>
                        <Button id="_IDGenButton2" text="Sign up" type="Transparent" press="signup"></Button>
                    </HBox>
                    
                    
                </VBox>
                <VBox id="_IDGenVBox3" ></VBox>
            </HBox>

            <HBox id="_IDGenHBox3" class="hbox1" width="50%" justifyContent="Center" alignItems="Center" >

                <VBox id="_IDGenVBox" class="sapUiSmallMargin" >
                    <Text id="_IDGenText2" text=" We are so excited to have you here.If you haven't already, create an account to get access to exclusive offers, rewards, and discounts."></Text>
                    <Button id="_IDGenButton" text="No account yet? Sign up." type="Transparent" press="signup"></Button>
                </VBox>
            </HBox>
        
        </VBox>


            <!-- <Toolbar id="_IDGenToolbar7" >
                      <MessageStrip id="_IDGenMessageStrip2"
                        text="Error with default icon and close button:"
                        type="Error"
                        showIcon="true"
                        showCloseButton="true"
                        class="sapUiMediumMarginBottom"
                       >
                    </MessageStrip>
            
            </Toolbar>
         -->



    </Page>
</mvc:View>