<mvc:View
 controllerName="banksystem.controller.View3"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt"
    xmlns:table="sap.ui.table" 
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
>
    <Page id="page3" title="{i18n>title}" showHeader="false" >

        <HBox id="_IDGenHBox13" >
            <VBox id="_IDGenVBox6" width="21%" height="100%" >

           
                <HBox id="_IDGenHBox14"  class="sapUiLargeMarginBottom" >
                        <Image id="_IDGenImage2"  class="sapUiTinyMarginEnd" src="image/cube.png" width="40px" height="40px"></Image>
                        <Title id="_IDGenTitle4"  class="txt0" text="Horizon" level="H1"></Title>
                </HBox>
                <!-- <SearchField id="_IDGenSearchField" width="80%" class="sapUiSmallMargin" placeholder="Search" /> -->
               
            

                <VBox id="_IDGenVBox28"  >
                  
                    <Button id="_IDGenButton8" text="Home" icon="sap-icon://home" type="Emphasized" width="45%" class="btn0"></Button>
                    <Button id="_IDGenButton9" text="My Bank" icon="sap-icon://home" type="Transparent" width="51%" press="Onbank" class="btn0"></Button>
                    <Button id="_IDGenButton10" text="Transaction History" icon="sap-icon://home" type="Transparent" width="75%" press="history" class="btn0"></Button>
                    <Button id="_IDGenButton11" text="Payment Transfer" icon="sap-icon://home" type="Transparent" width="71%" press="payment" class="btn0"></Button>
                    <Button id="_IDGenButton12" text="Connect Bank" icon="sap-icon://home" type="Transparent" width="62%" press="connectBank" class="btn0"></Button>
                    <Button id="_IDGenButton34"  text="Add Money" icon="sap-icon://home" type="Transparent" width="56%" press="AddMoney" class="btn0"></Button>
                    
                
                
                </VBox>
                

                
            </VBox>

            <VBox id="_IDGenVBox22" width="55%" class="sapUiTinyMarginEnd">
            <HBox id="_IDGenHBox16" class="sapUiSmallMarginTop">
                <Title id="_IDGenTitle6" text="Welcome" level="H1" class="sapUiSmallMarginEnd"></Title>
                 <Title id="_IDGenTitle7" text="{MasterModel>/0/First_name}" level="H1" ></Title>
            </HBox>
                 <Text id="_IDGenText21" text="Access and manage your account and transactions efficiently."></Text>

                 <Panel id="_IDGenPanel" class="sapUiSmallMarginBottom" >
                    <HBox id="_IDGenHBox17" >

                          <Panel id="_IDGenPanel3" height="180px" width="470px">
                          
                           <viz:VizFrame id="idVizFrame2" uiConfig="{applicationSet:'fiori'}"
                                    height='100%' width="100%" vizType='donut'>
                                    <viz:dataset>
                                        <viz.data:FlattenedDataset id="_IDGenFlattenedDataset2" data="{BankModel>/}">
                                            <viz.data:dimensions>
                                                <viz.data:DimensionDefinition id="_IDGenDimensionDefinition2" name="Store Name"
                                                    value="{BankModel>bank_name}" />
                                            </viz.data:dimensions>
                                            <viz.data:measures>
                                                <viz.data:MeasureDefinition id="_IDGenMeasureDefinition2" name="Amount"
                                                    value="{BankModel>amount}" />
                                            </viz.data:measures>
                                        </viz.data:FlattenedDataset>
                                    </viz:dataset>

                                    <viz:feeds>
                                        <viz.feeds:FeedItem id="_IDGenFeedItem" uid="size" type="Measure"
                                            values="Amount" />
                                        <viz.feeds:FeedItem id="_IDGenFeedItem1" uid="color" type="Dimension"
                                            values="Store Name" />
                                    </viz:feeds>
                                    <viz:dependents>
                                        <viz:Popover id="idPopOver"></viz:Popover>
                                    </viz:dependents>
                                </viz:VizFrame>
                          
                          
                          
                          </Panel>



                        <VBox id="_IDGenVBox25"  class="sapUiLargeMarginEnd">
                            <Text id="_IDGenText22" text="" width="100%" class="sapUiSmallMarginBottom"></Text>
                            <Text id="_IDGenText23" text="Total Current Balance"></Text>
                            <Label id="_IDGenLabel" text="" design="Bold"></Label>
                        </VBox>

                        <FlexBox id="_IDGenFlexBox" width="42%" justifyContent="End">
                        <Link id="_IDGenLink" text="+ Add bank" href="" press="connectBank" class="link1"></Link>
                        </FlexBox>
                    </HBox>
                 </Panel>

                  <VBox id="_IDGenVBox26" >
                            <Toolbar id="_IDGenToolbar" >
                            <content>
                            <ToolbarSpacer id="_IDGenToolbarSpacer" ></ToolbarSpacer>
                               	<ComboBox id="_IDGenComboBox" selectionChange="onBankChange" placeholder="Select Bank Name" items="{BankModel>/}"  selectedKey="{selectedBank}">
                                    <core:Item id="_IDGenItem" key="{BankModel>bank_name}" text="{BankModel>bank_name}" />
                                </ComboBox>
                            </content>
                            </Toolbar>


                            <Table id="_IDGenTable" items="{TransctionModel>/}" growing="true"
                                growingThreshold="5"
                                growingScrollToLoad="false" >
                                <columns>
                                <Column id="_IDGenColumn" > <Text id="_IDGenText25" text="Transaction"></Text></Column>
                                <Column id="_IDGenColumn1" > <Text id="_IDGenText26" text="Amount"></Text></Column>
                                <Column id="_IDGenColumn2" > <Text id="_IDGenText27" text="Status"></Text></Column>
                                <Column id="_IDGenColumn3" > <Text id="_IDGenText28" text="Date"></Text></Column>
                                <Column id="_IDGenColumn4" > <Text id="_IDGenText29" text="Category"></Text></Column>
                                </columns>

                                <items>
                                <ColumnListItem id="_IDGenColumnListItem" >
                                    <cells>
                                    <Text id="_IDGenText30" text="{TransctionModel>transaction}"></Text>
                                    <Text id="_IDGenText31" text="$ {TransctionModel>amount}"></Text>
                                    <tnt:InfoLabel id="il4" text="{TransctionModel>status}" renderMode="Narrow" colorScheme="4"/>
                                    <Text id="_IDGenText32" text="{TransctionModel>createdAt}"></Text>
                                    <GenericTag id="_IDGenGenericTag" text="{TransctionModel>category}" status="Warning" />
                                    </cells>
                                </ColumnListItem>
                                </items>
                            </Table>
                        
                    </VBox>

            
            </VBox>

            <VBox id="_IDGenVBox23"  width="25%" class="sapUiSmallMarginBottom">
            <VBox id="_IDGenVBox24" class="vbox0" alignItems="Start" justifyContent="End" width="100%" height="20%" >
             <Avatar id="_IDGenAvatar" displayShape="Circle" initials="SK" displaySize="M" tooltip="Profile Avatar" class="avt1"> </Avatar>
            </VBox>

            <Title id="_IDGenTitle5" text="{MasterModel>/0/name}" level="H1" class="sapUiLargeMarginTop"></Title>
            <Text id="_IDGenText19" text="{MasterModel>/0/email}" class="sapUiLargeMarginBottom"></Text>

            <HBox id="_IDGenHBox15" alignItems="Center" justifyContent="SpaceBetween" >
                <Text id="_IDGenText20" text="My Bank"></Text>
                <Button id="_IDGenButton6" text="+ Add bank" type="Transparent" press="connectBank"></Button>
            </HBox>

            <Panel id="_IDGenPanel1" class="pnl1" width="350px" >

                    <VBox id="_IDGenVBox55"  width="100%" height="150px" class="vbbb">
                        <Label id="_IDGenLabel27" class="labeldes1 sapUiSmallMarginBottom sapUiTinyMarginTop" text="HDFC" design="Bold"></Label>
                        <Label id="_IDGenLabel28" text="1234567891234567" class="lab2" width="250px" design="Bold"></Label>
                       
                        <Label id="_IDGenLabel29" text="19/09/9876" width="250px" class="lab3 sapUiLargeMarginStart"></Label>
                           
                    </VBox>
            </Panel>

       
           
            </VBox>
        </HBox>


        <footer>
          
            <Toolbar id="_IDGenToolbar1" width="260px" design="Transparent">
                <content>
                <HBox id="_IDGenHBox12">
                    <Avatar id="_IDGenAvatar1" displayShape="Circle" initials="SK" displaySize="XS" tooltip="Profile Avatar" class="sapUiTinyMarginEnd avt2"> </Avatar> 
                <VBox id="_IDGenVBox27" >
                    <Title id="_IDGenTitle9" text="{MasterModel>/0/name}" level="H3" class="tit1" ></Title>
                    <Text id="_IDGenText33"  text="{MasterModel>/0/email}" class="txt3"></Text>
                </VBox>
                </HBox>
                
               
                </content>
            </Toolbar>
        </footer>

    </Page>
</mvc:View>